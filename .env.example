# FACTSIFT AI Configuration Template
# Copy this file to backend/.env and replace placeholders. Never expose API keys in frontend code.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:8000
RATE_LIMIT_MAX=60
